# Copia este archivo a .env (scripts/run.sh lo hace solo la primera vez) y cambia los valores.
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=change-me-db-password

# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars

# Cuentas de demo que se crean al arrancar (scripts/run.sh pone contraseñas aleatorias y las muestra)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-admin-password
APP_USER_USERNAME=user
APP_USER_PASSWORD=change-me-user-password

# Permite a scripts/seed.sh borrar los datos de negocio antes de cargar los de demo
ADMIN_RESET_ENABLED=true

# Zona horaria que define "hoy" (fechas de inicio, validación @FutureOrPresent). Es el único lugar donde se configura.
APP_TIMEZONE=America/Bogota
