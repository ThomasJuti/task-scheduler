# Copy to .env (scripts/run.sh does it automatically on the first run) and change the values.
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=change-me-db-password

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars

# Demo accounts created on startup
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=Admin123!
APP_USER_USERNAME=user
APP_USER_PASSWORD=User123!

# Lets scripts/seed.sh wipe the business data before loading the demo data
ADMIN_RESET_ENABLED=true
